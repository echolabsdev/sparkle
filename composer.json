{
    "name": "particle-academy/prism",
    "description": "A powerful Laravel package for integrating Large Language Models (LLMs) into your applications. Actively maintained fork of prism-php/prism.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Prism\\Prism\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "TJ Miller",
            "email": "hello@echolabs.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "laravel/framework": "^12.61.1|^13.12.0",
        "psr/http-message": "^1.1|^2.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/http-foundation": "^7.2|^8.0",
        "symfony/polyfill-php83": "^1.32"
    },
    "replace": {
        "prism-php/prism": "self.version"
    },
    "suggest": {
        "laravel/mcp": "Required to expose Prism tools through a Laravel MCP server (LaravelMcpTool)."
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "brianium/paratest": "^7.8.4",
        "laravel/pint": "1.30.4",
        "phpstan/phpstan": "2.1.34",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "2.3.3",
        "orchestra/testbench": "^10|^11",
        "mockery/mockery": "^1.6",
        "laravel/mcp": "^0.6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Prism\\Dev\\": "dev/",
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "format": [
            "@php vendor/bin/pint --ansi --parallel",
            "@php vendor/bin/rector process --no-diffs"
        ],
        "test": [
            "@php vendor/bin/pest --parallel"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "types": [
            "@php vendor/bin/phpstan analyse --verbose --no-ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prism\\Prism\\PrismServiceProvider"
            ],
            "aliases": {
                "PrismServer": "Prism\\Prism\\Facades\\PrismServer"
            }
        }
    }
}
